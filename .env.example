# ================================================================
# .env.example - VibeStream
# Copy this to `.env` and fill secrets/values before running locally or in CI.
# ================================================================

# ======================
# DATABASE
# ======================
# docker-compose ya incluye un servicio `postgres` (host `postgres` en
# la red vibestream-network, bootstrapped con schema_reconstruido.sql).
# POSTGRES_USER/PASSWORD/DB deben coincidir con el user:pass:db de las
# dos URLs de abajo (docker-compose no soporta variables derivadas de
# otras variables dentro de un mismo .env, mismo caso que RABBITMQ).
POSTGRES_USER=vibestream
POSTGRES_PASSWORD=vibestream
POSTGRES_DB=vibestream

# For Python services (asyncpg)
db_url_py=postgresql+asyncpg://vibestream:vibestream@postgres:5432/vibestream
# For Go services
DB_URL=postgresql://vibestream:vibestream@postgres:5432/vibestream?sslmode=disable

# ======================
# JWT
# ======================
JWT_SECRET=change_me
JWT_ALGORITHM=HS256

# ======================
# RABBITMQ
# ======================
# Fase 6: RABBITMQ_USER/RABBITMQ_PASS configuran las credenciales reales
# del broker (antes hardcodeadas a guest/guest en docker-compose.yml).
# docker-compose no soporta variables derivadas de otras variables dentro
# de un mismo .env, así que si cambiás estas dos, actualizá RABBITMQ_URL
# manualmente para que coincida (usuario:contraseña deben ser los mismos).
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
# In docker-compose the broker host is `rabbitmq`
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# ======================
# CORS
# ======================
# Comma-separated allowed frontend origins for CORS (use production domain in prod)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_ORIGINS=*

# ======================
# SERVICE PORTS
# ======================
AUTH_PORT=8080
ARTIST_PORT=8002
CONTENT_PORT=8001
HISTORY_PORT=8005
PLAYLIST_PORT=8004
SEARCH_PORT=8006
STREAMING_PORT=8003
SUBSCRIPTION_PORT=8007

# ======================
# INTERNAL SERVICE URLS (Fase 3: propiedad de datos por servicio)
# ======================
# Nombres DNS de Docker Compose, misma red vibestream-network
CONTENT_SERVICE_URL=http://content-service:8001
ARTIST_SERVICE_URL=http://artist-service:8002
AUTH_SERVICE_URL=http://auth-service:8080

# ======================
# FILES / STORAGE
# ======================
# If you serve media from S3, use the public bucket URL; otherwise point to files service
FILES_BASE_URL=https://vibestream-media.s3.us-east-1.amazonaws.com

# ======================
# AWS S3
# ======================
# docker-compose incluye un servicio `localstack` que emula S3 (ver
# localstack/init/ — crea el bucket solo al arrancar). AWS_ENDPOINT_URL
# es lo que activa el modo LocalStack en content-service, artist-service
# y streaming-service (los 3 que hablan con S3): si está seteado, boto3
# / el SDK de Go apuntan ahí en vez de a AWS real, con addressing "path
# style" (obligatorio para LocalStack). Las credenciales no se validan
# contra nada real, pero deben ser no vacías.
AWS_ENDPOINT_URL=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
AWS_S3_BUCKET=vibestream-media
# Para producción real: comentar/borrar AWS_ENDPOINT_URL y usar
# credenciales/rol de AWS real — el código cae automáticamente al
# comportamiento de AWS real cuando esta variable no está seteada.

# ======================
# NOTES
# - Do NOT commit your real `.env` with secrets. Use `.env.example` as template.
# - In production, prefer using secret management (Secrets Manager, Parameter Store, etc.)
