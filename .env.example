# ================================================================
# .env.example - VibeStream
# Copy this to `.env` and fill secrets/values before running locally or in CI.
# ================================================================

# ======================
# DATABASE
# ======================
# For Python services (asyncpg)
db_url_py=postgresql+asyncpg://<user>:<pass>@<host>:5432/<db>
# For Go services
DB_URL=postgresql://<user>:<pass>@<host>:5432/<db>

# ======================
# JWT
# ======================
JWT_SECRET=change_me
JWT_ALGORITHM=HS256

# ======================
# RABBITMQ
# ======================
# Fase 6: RABBITMQ_USER/RABBITMQ_PASS configuran las credenciales reales
# del broker (antes hardcodeadas a guest/guest en docker-compose.yml).
# docker-compose no soporta variables derivadas de otras variables dentro
# de un mismo .env, así que si cambiás estas dos, actualizá RABBITMQ_URL
# manualmente para que coincida (usuario:contraseña deben ser los mismos).
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
# In docker-compose the broker host is `rabbitmq`
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# ======================
# CORS
# ======================
# Comma-separated allowed frontend origins for CORS (use production domain in prod)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_ORIGINS=*

# ======================
# SERVICE PORTS
# ======================
AUTH_PORT=8080
ARTIST_PORT=8002
CONTENT_PORT=8001
HISTORY_PORT=8005
PLAYLIST_PORT=8004
SEARCH_PORT=8006
STREAMING_PORT=8003
SUBSCRIPTION_PORT=8007

# ======================
# INTERNAL SERVICE URLS (Fase 3: propiedad de datos por servicio)
# ======================
# Nombres DNS de Docker Compose, misma red vibestream-network
CONTENT_SERVICE_URL=http://content-service:8001
ARTIST_SERVICE_URL=http://artist-service:8002
AUTH_SERVICE_URL=http://auth-service:8080

# ======================
# FILES / STORAGE
# ======================
# If you serve media from S3, use the public bucket URL; otherwise point to files service
FILES_BASE_URL=https://vibestream-media.s3.us-east-1.amazonaws.com

# ======================
# AWS S3 (leave blank for local dev)
# ======================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
AWS_S3_BUCKET=vibestream-media

# ======================
# NOTES
# - Do NOT commit your real `.env` with secrets. Use `.env.example` as template.
# - In production, prefer using secret management (Secrets Manager, Parameter Store, etc.)
